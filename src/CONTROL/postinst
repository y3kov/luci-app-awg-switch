#!/bin/sh
[ "${IPKG_INSTROOT}" != "" ] && exit 0

mkdir -p /etc/awgswitch/backup
if [ ! -f /etc/awgswitch/backup/network.orig ]; then
    cp /etc/config/network /etc/awgswitch/backup/network.orig
    cp /etc/config/firewall /etc/awgswitch/backup/firewall.orig
    cp /etc/config/dhcp /etc/awgswitch/backup/dhcp.orig
    date "+%Y-%m-%d %H:%M:%S" > /etc/awgswitch/backup/timestamp
fi

chmod +x /usr/libexec/awgswitch/ctl.sh
chmod 755 /usr/bin/amneziawg 2>/dev/null || true
chmod 755 /usr/bin/amneziawg_watchdog 2>/dev/null || true
[ -f /lib/netifd/proto/amneziawg.sh ] && chmod 755 /lib/netifd/proto/amneziawg.sh

# Симлинк awg -> amneziawg для совместимости утилит
ln -sf /usr/bin/amneziawg /usr/bin/awg 2>/dev/null

# Подгрузка модуля ядра
KVER=$(uname -r 2>/dev/null)
if [ ! -d /sys/module/amneziawg ]; then
    modprobe amneziawg >/dev/null 2>&1 || insmod "/lib/modules/$KVER/amneziawg.ko" >/dev/null 2>&1 || insmod /lib/modules/5.15.137/amneziawg.ko >/dev/null 2>&1 || true
fi
rm -rf /tmp/luci-*
/etc/init.d/rpcd restart >/dev/null 2>&1
exit 0
