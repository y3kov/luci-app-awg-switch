#!/bin/sh
[ "${IPKG_INSTROOT}" != "" ] && exit 0

mkdir -p /etc/awgswitch/backup
if [ ! -f /etc/awgswitch/backup/network.orig ]; then
    cp /etc/config/network /etc/awgswitch/backup/network.orig
    cp /etc/config/firewall /etc/awgswitch/backup/firewall.orig
    cp /etc/config/dhcp /etc/awgswitch/backup/dhcp.orig
    date "+%Y-%m-%d %H:%M:%S" > /etc/awgswitch/backup/timestamp
fi

chmod +x /usr/libexec/awgswitch/ctl.sh

# Симлинк awg <-> amneziawg для совместимости утилит
if [ ! -e /usr/bin/awg ] && [ -x /usr/bin/amneziawg ]; then
    ln -sf /usr/bin/amneziawg /usr/bin/awg
elif [ ! -e /usr/bin/amneziawg ] && [ -x /usr/bin/awg ]; then
    ln -sf /usr/bin/awg /usr/bin/amneziawg
fi

# Патч netifd proto для виртуального интерфейса awg
if [ -f /lib/netifd/proto/amneziawg.sh ] && ! grep -q "no_device=1" /lib/netifd/proto/amneziawg.sh; then
    sed -i '/proto_amneziawg_init_config()/a \    no_device=1' /lib/netifd/proto/amneziawg.sh 2>/dev/null || true
fi

modprobe amneziawg >/dev/null 2>&1 || true
rm -rf /tmp/luci-indexcache /tmp/luci-modulecache
/etc/init.d/rpcd restart >/dev/null 2>&1
exit 0
