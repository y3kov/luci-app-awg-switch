set awg_vpn_devices {
	type ipv4_addr
	flags interval
}

chain awg_vpn_dstnat {
	type nat hook prerouting priority dstnat - 5; policy accept;
	iifname "br-lan" ip saddr @awg_vpn_devices ip daddr 192.168.0.0/16 udp dport 53 counter dnat ip to 1.1.1.1:53
	iifname "br-lan" ip saddr @awg_vpn_devices ip daddr 192.168.0.0/16 tcp dport 53 counter dnat ip to 1.1.1.1:53
	iifname "br-lan" ip saddr @awg_vpn_devices udp dport 53 accept
	iifname "br-lan" ip saddr @awg_vpn_devices tcp dport 53 accept
}

chain awg_vpn_forward {
	type filter hook forward priority filter - 1; policy accept;
	iifname "br-lan" ip saddr @awg_vpn_devices tcp dport 853 accept
	iifname "br-lan" ip saddr @awg_vpn_devices udp dport 853 accept
}
