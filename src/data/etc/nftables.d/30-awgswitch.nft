set awg_vpn_devices {
	type ipv4_addr
	flags interval
}

set awg_direct_devices {
	type ipv4_addr
	flags interval
}

chain awg_vpn_dstnat {
	type nat hook prerouting priority dstnat - 5; policy accept;
	iifname "br-lan" ip saddr @awg_vpn_devices udp dport 53 counter dnat ip to 1.1.1.1:53
	iifname "br-lan" ip saddr @awg_vpn_devices tcp dport 53 counter dnat ip to 1.1.1.1:53
}

chain awg_direct_dstnat {
	type nat hook prerouting priority dstnat - 4; policy accept;
	iifname "br-lan" ip saddr @awg_direct_devices udp dport 53 accept
	iifname "br-lan" ip saddr @awg_direct_devices tcp dport 53 accept
}

chain awg_vpn_input {
	type filter hook input priority filter - 1; policy accept;
	iifname "br-lan" meta nfproto ipv6 udp dport 53 counter reject with icmpv6 type port-unreachable
	iifname "br-lan" meta nfproto ipv6 tcp dport 53 counter reject with tcp reset
}

chain awg_bypass_mangle {
	type filter hook prerouting priority mangle; policy accept;
	iifname "br-lan" ip saddr @awg_direct_devices ct mark set ct mark | 0x00800000
}

chain awg_vpn_forward {
	type filter hook forward priority filter - 1; policy accept;
	iifname "br-lan" ip saddr @awg_vpn_devices tcp dport 853 accept
	iifname "br-lan" ip saddr @awg_vpn_devices udp dport 853 accept
	iifname "br-lan" ip saddr @awg_direct_devices tcp dport 853 accept
	iifname "br-lan" ip saddr @awg_direct_devices udp dport 853 accept
}
